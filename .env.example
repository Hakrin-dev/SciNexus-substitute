# 研枢 SciNexus 部署环境变量示例
# 复制为 .env 后按需填写;不填这些变量也可正常运行(当前为纯前端 mock 数据)

# 将来接入真实后端时,前端访问后端的公网基础地址
# 示例:https://api.example.com 或 http://47.238.241.77:8080
# NEXT_PUBLIC_API_URL=http://localhost:8000

# 会话签名密钥（生产环境必填，建议至少 32 字节随机值）
AUTH_SECRET=replace-with-a-long-random-secret

# 数据库连接(规划中,接入时再填)
# DATABASE_URL=

# OpenAI 兼容的 LLM 接口（不填则使用内置规则回复）
# LLM_API_URL=https://api.openai.com/v1
# LLM_API_KEY=
# 默认模型；“默认”选项使用此模型
# LLM_MODEL=gpt-4o-mini
# “订阅”和“API接入”未单独配置时回退到 LLM_MODEL
# LLM_SUBSCRIPTION_MODEL=
# LLM_API_MODEL=
# 自动研究 worker（与 Web 共享 data/ 目录）
AUTO_RESEARCH_LLM_ENABLED=true
AUTO_RESEARCH_OFFLINE=false
AUTO_RESEARCH_RUNS_ROOT=data/research-runs
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=
