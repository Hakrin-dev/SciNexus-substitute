# 研枢 SciNexus 部署环境变量示例
# 复制为 .env 后按需填写;不填这些变量也可正常运行(当前为纯前端 mock 数据)

# 将来接入真实后端时,前端访问后端的公网基础地址
# 示例:https://api.example.com 或 http://47.238.241.77:8080
# NEXT_PUBLIC_API_URL=http://localhost:8000

# 远程知识底座：remote=远程优先，local=仅本地，hybrid=远程并保留本地检索入口
RETRIEVAL_PROVIDER=remote
# 生产必须使用 HTTPS；若仅能通过受控内网 HTTP 访问，显式设置 RETRIEVAL_ALLOW_INSECURE_HTTP=true。
RETRIEVAL_API_URL=https://knowledge.example.com
# 知识底座服务令牌，只在服务端使用，绝不能以 NEXT_PUBLIC_ 前缀暴露。
# RETRIEVAL_API_TOKEN=
RETRIEVAL_TIMEOUT_SECONDS=30
RETRIEVAL_RETRY_COUNT=2
RETRIEVAL_DEFAULT_TOP_K=10
RETRIEVAL_FALLBACK_LOCAL=true
RETRIEVAL_CIRCUIT_FAILURE_THRESHOLD=3
RETRIEVAL_CIRCUIT_RESET_SECONDS=30

# 生产必须设置为至少 32 字节的随机值，并通过部署平台的 secret 管理注入。
# AUTH_SECRET=

# 数据库连接(规划中,接入时再填)
# DATABASE_URL=

# OpenAI 兼容的 LLM 接口（不填则使用内置规则回复）
# LLM_API_URL=https://api.openai.com/v1
# LLM_API_KEY=
# 默认模型；“默认”选项使用此模型
# LLM_MODEL=gpt-4o-mini
# “订阅”和“API接入”未单独配置时回退到 LLM_MODEL
# LLM_SUBSCRIPTION_MODEL=
# LLM_API_MODEL=
