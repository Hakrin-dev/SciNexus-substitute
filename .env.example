# 研枢 SciNexus 部署环境变量示例
# ────────────────────────────────────────────────────────────
# 用法:
#   本地开发 — 复制为 .env.local 后按需填写(所有变量均有默认值,不填也能跑)
#   Vercel   — Dashboard → Settings → Environment Variables → "Import .env" 粘贴,
#              scope 选 Production,保存后必须 Redeploy 才生效
#
# 类型规范(与 Vercel 对应):
#   [Plain]     非凭据配置(地址/开关/数值),泄露无安全风险
#   [Sensitive] 凭据类(Token/密钥),必须加密存储,绝不入仓库/截图/日志
#   凭据类变量一律不带 NEXT_PUBLIC_ 前缀(仅服务端可见)

# ── 知识底座(远程论文检索/详情/图谱)──────────────────────
# 检索提供方:remote=远程优先(默认) | local=仅本地 SQLite | hybrid=远程+本地入口
# [Plain]
RETRIEVAL_PROVIDER=remote
# 知识底座基础地址(不要拼接口路径),生产必须显式配置;
# 不配置时远程 Knowledge API 返回"尚未配置",不会请求硬编码地址。
# 生产环境强制 HTTPS;上游暂无 HTTPS 时,需同时设置 RETRIEVAL_ALLOW_INSECURE_HTTP=true(临时方案)
# 示例:https://knowledge.example.com;当前上游(2026-09):http://47.110.47.12
# [Plain]
RETRIEVAL_API_URL=
# 允许生产环境使用 HTTP 上游(明文传输,仅供临时联调,上游配好 HTTPS 后删除)
# [Plain]
RETRIEVAL_ALLOW_INSECURE_HTTP=true
# 知识底座访问令牌;上游允许匿名访问时可不填(当前 47.110.47.12 即匿名)
# [Sensitive — 如需配置,在 Vercel 中必须选 Sensitive]
# RETRIEVAL_API_TOKEN=
# 上游请求超时(秒)/ 重试次数 / 检索默认条数(1~50,建议 ≤20)
# [Plain]
RETRIEVAL_TIMEOUT_SECONDS=30
RETRIEVAL_RETRY_COUNT=1
RETRIEVAL_DEFAULT_TOP_K=10
# 远程不可用时是否回退本地演示数据;正式环境默认不把本地演示数据伪装成远程结果
# [Plain]
RETRIEVAL_FALLBACK_LOCAL=false
# 熔断器:连续失败 N 次开路,开路 M 秒后恢复探测
# [Plain]
RETRIEVAL_CIRCUIT_FAILURE_THRESHOLD=3
RETRIEVAL_CIRCUIT_RESET_SECONDS=30
# PDF 由服务端代理下载;默认最多 50 MiB,拒绝解析到私网的 PDF 地址。
# 受控内网知识库可显式开启,切勿在公网部署中开启。
# KNOWLEDGE_PDF_MAX_BYTES=52428800
# KNOWLEDGE_PDF_ALLOW_PRIVATE_NETWORK=false

# ── 会话签名密钥(必填,生产)──────────────────────────────
# 至少 32 字节随机值(如 `openssl rand -hex 32`),通过部署平台 secret 管理注入
# [Sensitive — Vercel 已于 2026-09-01 配置]
# AUTH_SECRET=

# ── SQLite 持久化路径(容器部署建议配置)──────────────────
# Docker Compose 使用 /app/data 卷；SCINEXUS_DB_PATH 为现有生产配置名。
# Vercel/Serverless 无持久本地磁盘，不应使用 SQLite 承载生产账户数据。
# [Plain]
SCINEXUS_DB_PATH=
# 兼容名（未设置 SCINEXUS_DB_PATH 时使用）
# AUTH_DB_PATH=

# ── 邮件服务(注册验证码/密码重置,可选)────────────────────
# 邮件提供方:aliyun-directmail(阿里云邮件推送)
# 未配置时,验证码在开发环境打印到控制台;生产环境会返回"邮件服务未配置"错误
# [Plain]
EMAIL_PROVIDER=
# 阿里云 AccessKey(需开通邮件推送服务)
# [Sensitive]
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
# 阿里云邮件推送 Region ID 与 Endpoint
# [Plain]
ALIYUN_DIRECTMAIL_REGION_ID=cn-hangzhou
ALIYUN_DIRECTMAIL_ENDPOINT=dm.aliyuncs.com
# 发件邮箱地址与发件人别名(需在阿里云控制台验证过的发信地址)
# [Plain]
AUTH_EMAIL_FROM=
AUTH_EMAIL_FROM_ALIAS=研枢 SciNexus
# 生产环境是否强制要求邮件服务已配置(默认 false,允许开发降级到控制台输出)
# [Plain]
EMAIL_REQUIRED=false
# 应用公开地址(用于密码重置邮件中的链接;生产必须使用 HTTPS)
# [Plain]
APP_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Cloudflare Turnstile 人机验证(可选)────────────────────
# 未配置时跳过人机验证,不影响注册/登录/找回密码流程。
# 配置后,发送验证码等敏感接口需先通过 Turnstile 验证。
# [Sensitive]
TURNSTILE_SECRET_KEY=
# 是否启用 Turnstile(默认:配置了 secret key 即启用;设为 false 可显式关闭)
# [Plain]
TURNSTILE_ENABLED=
# 前端站点密钥(配置后前端才会渲染 Turnstile 组件)
# [Plain]
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── OpenAI 兼容 LLM 接口(可选)───────────────────────────
# 不填则 AI 相关功能使用内置规则回复
# LLM_API_URL=https://api.openai.com/v1
# [Sensitive — 如需配置,必须选 Sensitive]
# LLM_API_KEY=
# 默认模型;"默认"选项使用此模型
# LLM_MODEL=gpt-4o-mini
# "订阅"和"API接入"未单独配置时回退到 LLM_MODEL
# LLM_SUBSCRIPTION_MODEL=
# LLM_API_MODEL=

# ── 外部后端覆盖(默认同源,一般不需要)────────────────────
# client.ts 默认同源 /api/*(命中 Next.js Route Handlers);
# 仅当接回独立 FastAPI 等外部后端时才设置前端可见的基础地址
# NEXT_PUBLIC_API_URL=http://localhost:8000
