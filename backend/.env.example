# 研枢后端环境变量示例（复制为 agent/.env 或直接设置环境变量）
# 注意：agent/.env 含真实密钥，已被 .gitignore 忽略，不要提交。

# ============ LLM 接入 ============
# mock | openai | ollama；填 openai 用 DeepSeek 等 OpenAI 兼容端点
LLM_PROVIDER=openai
OPENAI_API_KEY=your_key_here
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# DeepSeek 不支持 json_schema：json_object | auto | none
OPENAI_JSON_MODE=auto
LLM_TEMPERATURE=0.2

# ============ 数据层（本地 SQLite + mock 保底）============
# sqlite = 读 server/data/research.sqlite（真实入库语料）
# 加载失败时自动回退 json -> server_mock -> 内置兜底数据，保证接口始终可用
TOOL_DATA_SOURCE=sqlite
# SQLITE_PATH=server/data/research.sqlite
# 数据目录覆盖（Docker 部署必填）：指向 volume 挂载目录，容器内为 /app/data
# 默认 = 仓库内 server/data；不要指向 server/data 所在目录以免遮蔽 Python 包
# TOOL_DATA_DIR=/app/data

# 向量检索 embedding（需 Ollama nomic-embed-text；不可用自动降级词法检索）
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434

# ============ Agent 网关 ============
# false = 后端退化为纯 mock（不加载多智能体），快速验证接口联通
AGENT_ENABLED=true
