# 研枢后端环境变量示例（复制为 agent/.env 或直接设置环境变量）
# 注意：agent/.env 含真实密钥，已被 .gitignore 忽略，不要提交。

# ============ LLM 接入 ============
# mock | openai | ollama；填 openai 用 DeepSeek 等 OpenAI 兼容端点
LLM_PROVIDER=openai
OPENAI_API_KEY=your_key_here
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 前端模型选择“订阅”和“API接入”时使用；未填写则回退到 LLM_MODEL
LLM_SUBSCRIPTION_MODEL=
LLM_API_MODEL=
# DeepSeek 不支持 json_schema：json_object | auto | none
OPENAI_JSON_MODE=auto
LLM_TEMPERATURE=0.2

# ============ 数据层（本地 SQLite + mock 保底）============
# remote=知识底座优先；local=仅本地；hybrid=远程优先并保留本地检索入口
RETRIEVAL_PROVIDER=remote
# 生产使用 HTTPS；仅受控内网 HTTP 才可显式设置 RETRIEVAL_ALLOW_INSECURE_HTTP=true
RETRIEVAL_API_URL=https://knowledge.example.com
# RETRIEVAL_API_TOKEN=
RETRIEVAL_TIMEOUT_SECONDS=30
RETRIEVAL_RETRY_COUNT=2
RETRIEVAL_DEFAULT_TOP_K=10
RETRIEVAL_FALLBACK_LOCAL=true
RETRIEVAL_CIRCUIT_FAILURE_THRESHOLD=3
RETRIEVAL_CIRCUIT_RESET_SECONDS=30

# 生产认证密钥（至少 32 字节随机值；只通过密钥管理系统注入）
# AUTH_SECRET=
# 逗号分隔的可信浏览器来源；生产禁止使用 *。
CORS_ALLOW_ORIGINS=https://app.example.com

# sqlite = 读 server/data/research.sqlite（真实入库语料）
# 加载失败时自动回退 json -> server_mock -> 内置兜底数据，保证接口始终可用
TOOL_DATA_SOURCE=sqlite
# SQLITE_PATH=server/data/research.sqlite

# 向量检索 embedding（需 Ollama nomic-embed-text；不可用自动降级词法检索）
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434

# ============ 联网检索（前端「联网搜索」开关）============
# exa=Exa 托管 MCP（免 API key）；parallel=Parallel MCP；off=关闭
WEB_SEARCH_PROVIDER=exa
WEB_SEARCH_TOP_K=8
WEB_SEARCH_TIMEOUT=25
# 仅 parallel provider 需要（可选 Bearer key）
# PARALLEL_API_KEY=

# ============ Agent 网关 ============
# false = 后端退化为纯 mock（不加载多智能体），快速验证接口联通
AGENT_ENABLED=true
