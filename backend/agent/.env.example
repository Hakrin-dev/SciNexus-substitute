# ============ 多智能体科研助手 - 环境变量示例 ============
# 复制本文件为 .env 后按需修改（.env 已被 .gitignore 忽略，不会随代码分发泄露）。
#
# LLM 接入方式：mock | openai | ollama
LLM_PROVIDER=mock

# ---- OpenAI 兼容 API（LLM_PROVIDER=openai 时生效）----
# 兼容 OpenAI / DeepSeek / 通义 等任意 OpenAI 兼容端点
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# JSON 输出模式：schema | json_object | auto | none
#   schema=OpenAI Structured Outputs；DeepSeek 等端点不支持 json_schema 请用 json_object；
#   auto=按 base_url 含 "deepseek" 自动切换（默认）
OPENAI_JSON_MODE=auto
# Supervisor 专用模式覆盖项（默认继承 OPENAI_JSON_MODE）
SUPERVISOR_OPENAI_JSON_MODE=auto

# ---- Supervisor 专用模型（控制平面，未设置时继承上方通用 LLM）----
# 可配置为能力更强的模型；支持 mock | openai | ollama。默认继承通用 LLM。
# SUPERVISOR_LLM_PROVIDER=openai
# SUPERVISOR_OPENAI_API_KEY=
# SUPERVISOR_OPENAI_BASE_URL=https://api.deepseek.com/v1
# SUPERVISOR_LLM_MODEL=deepseek-reasoner
# SUPERVISOR_LLM_TEMPERATURE=0.1

# ---- Ollama 本地模型（LLM_PROVIDER=ollama 时生效）----
# 需先在本机启动 ollama serve 并拉取模型（如 ollama pull qwen2.5:7b）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# SUPERVISOR_OLLAMA_BASE_URL=http://localhost:11434
# SUPERVISOR_OLLAMA_MODEL=qwen2.5:14b

# 模型采样参数
LLM_TEMPERATURE=0.2

# 检索相关参数
TOP_K=10

# ---- 数据层（后端知识库）----
# 论文/会议数据源：
#   server_mock = server/data/mock_data.py（默认）
#   json        = server/data/papers.json
#   sqlite      = 读取 server/data/research.sqlite（先运行 scripts/ingest_openalex.py 灌入真实论文元数据）
TOOL_DATA_SOURCE=server_mock
# json 数据源路径（可选，默认 server/data/papers.json）
# TOOL_DATA_PATH=
# SQLite 论文/会议库路径（可选，默认 server/data/research.sqlite）
# SQLITE_PATH=
# 向量检索 embedding 模型（Ollama 本地，需 ollama pull nomic-embed-text；不可用自动降级词法检索）
EMBEDDING_MODEL=nomic-embed-text
# 交叉编码器重排模型（可选，sentence-transformers；未安装/不可用自动跳过重排，用 RRF 分数兜底）
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# HuggingFace 镜像端点（国内用 hf-mirror.com 下载模型，规避 huggingface.co 被墙）
HF_ENDPOINT=https://hf-mirror.com
# 论文 PDF 存放目录（可选，默认 server/data/pdfs/；可用 scripts/download_pdfs.py 批量下载）
# PDF_DIR=

# ---- Supervisor 模块白名单强制（可选）----
# 1 = 强制每个模块只能执行 INTENT_TABLE 允许的 agent（默认；弱模型也不会误调 writer/critic）
# 0 = 关闭强制，LLM 计划原样执行（仅调试用）
# SUPERVISOR_ENFORCE_ALLOWLIST=1
